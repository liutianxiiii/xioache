# ===========================================================
# STM32CubeIDE (Eclipse) workspace gitignore
# ===========================================================

# -------------------------------------------------------
# Eclipse / STM32CubeIDE workspace metadata
# Contains IDE state, resource snapshots (.snap), caches.
# Never useful to other developers — fully regenerated on import.
# -------------------------------------------------------
.metadata/

# -------------------------------------------------------
# Build output directories (Debug / Release)
# All generated: object files, ELF, HEX, MAP, listing, makefiles
# -------------------------------------------------------
**/Debug/
**/Release/

# Common build artifact extensions (belt-and-suspenders)
*.o
*.d
*.elf
*.hex
*.bin
*.map
*.list
*.a

# -------------------------------------------------------
# Eclipse resource snapshots (the original question)
# Generated by org.eclipse.core.resources; local IDE state only.
# -------------------------------------------------------
*.snap

# -------------------------------------------------------
# OS-generated junk
# -------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# -------------------------------------------------------
# Editor / IDE temp files
# -------------------------------------------------------
*.swp
*.swo
*~
