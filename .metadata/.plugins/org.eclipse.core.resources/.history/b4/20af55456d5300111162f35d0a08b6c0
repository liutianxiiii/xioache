// ════════════════════════════════════════════════
//  AE-TB67H450 SPI送信
//
//  16bitフレーム:
//    bit15  : PHASE (0=正転 / 1=逆転)
//    bit14  : EN    (1=動作 / 0=スタンバイ)
//    bit13-12: 予約 (0)
//    bit11-0 : DUTY (0x000〜0xFFF)
// ════════════════════════════════════════════════
void Motor_Write(GPIO_TypeDef *cs_port, uint16_t cs_pin,
                 uint8_t phase, uint16_t duty)
{
  if (duty > 0x0FFF) duty = 0x0FFF;

  uint16_t frame = 0;
  frame |= (phase ? 0x8000 : 0x0000);  // PHASE
  frame |= 0x4000;                      // EN=1
  frame |= (duty & 0x0FFF);            // DUTY

  // ビッグエンディアンでSPI送信
  uint8_t tx[2];
  tx[0] = (frame >> 8) & 0xFF;
  tx[1] =  frame       & 0xFF;

  HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);  // CS Low
  HAL_SPI_Transmit(&hspi1, tx, 2, 10);                 // 送信
  HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);    // CS High
}

// ════════════════════════════════════════════════
//  左右モータ同時制御
//  引数: -4095〜+4095 (負=逆転)
// ════════════════════════════════════════════════
void Motor_Drive(int16_t left, int16_t right)
{
  uint8_t  lp = (left  < 0) ? 1 : 0;
  uint8_t  rp = (right < 0) ? 1 : 0;
  uint16_t ld = (uint16_t)(left  < 0 ? -left  : left);
  uint16_t rd = (uint16_t)(right < 0 ? -right : right);

  Motor_Write(CS_LEFT_PORT,  CS_LEFT_PIN,  lp, ld);
  Motor_Write(CS_RIGHT_PORT, CS_RIGHT_PIN, rp, rd);
}

void Motor_Stop(void)
{
  Motor_Write(CS_LEFT_PORT,  CS_LEFT_PIN,  0, SPD_STOP);
  Motor_Write(CS_RIGHT_PORT, CS_RIGHT_PIN, 0, SPD_STOP);
}

// ════════════════════════════════════════════════
//  ライントレース制御
//
//  センサ配置:  [A] [B] [C] [D]
//               左            右
//
//  判定ロジック:
//    B黒&C黒        → 直進
//    B白&C黒        → 右に補正（左を落とす）
//    B黒&C白        → 左に補正（右を落とす）
//    A,B白&C,D黒    → 大きく右旋回
//    A,B黒&C,D白    → 大きく左旋回
//    全白            → 停止
// ════════════════════════════════════════════════
void Line_Control(void)
{
  uint8_t a = SENS_A;
  uint8_t b = SENS_B;
  uint8_t c = SENS_C;
  uint8_t d = SENS_D;

  // 全白 = ライン見失い
  if (!a && !b && !c && !d) {
    Motor_Stop();
    return;
  }

  // 大きく右逸脱: A,B白 / C,D黒
  if (!a && !b && c && d) {
    Motor_Drive(SPD_FULL, SPD_SLOW);
    return;
  }

  // 大きく左逸脱: A,B黒 / C,D白
  if (a && b && !c && !d) {
    Motor_Drive(SPD_SLOW, SPD_FULL);
    return;
  }

  // 中央OK: B,C両方黒
  if (b && c) {
    Motor_Drive(SPD_FULL, SPD_FULL);
    return;
  }

  // 少し右寄り: B白/C黒 → 左を増やして右補正
  if (!b && c) {
    Motor_Drive(SPD_FULL, SPD_MEDIUM);
    return;
  }

  // 少し左寄り: B黒/C白 → 右を増やして左補正
  if (b && !c) {
    Motor_Drive(SPD_MEDIUM, SPD_FULL);
    return;
  }

  // その他
  Motor_Drive(SPD_FULL, SPD_FULL);
}

