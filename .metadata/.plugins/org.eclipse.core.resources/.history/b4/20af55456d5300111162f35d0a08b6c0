// ── ADC DMAバッファ ──────────────────────────────
// ADC変換順: CH1(PA0)=A, CH2(PA1)=B, CH3(PA3)=C, CH4(PB0)=D
volatile uint16_t adc_buf[4];
volatile uint8_t  adc_ready = 0;   // DMA完了フラグ

// ── センサ黒判定しきい値 ─────────────────────────
// 実測して調整。黒で値が低い前提（反射型センサ一般）
#define BLACK_TH   1500    // 0〜4095 (12bit ADC)

// センサ判定結果 (1=黒, 0=白)
#define SENS_A   ((adc_buf[0] < BLACK_TH) ? 1 : 0)
#define SENS_B   ((adc_buf[1] < BLACK_TH) ? 1 : 0)
#define SENS_C   ((adc_buf[2] < BLACK_TH) ? 1 : 0)
#define SENS_D   ((adc_buf[3] < BLACK_TH) ? 1 : 0)

// ── モータ速度定義 (0〜4095, 12bit) ──────────────
#define SPD_FULL    2800
#define SPD_MEDIUM  1800
#define SPD_SLOW     800
#define SPD_STOP       0

// ── AE-TB67H450 CSピン ───────────────────────────
// CubeMXでGPIO OutputとしてCS1,CS2を設定すること
// 例: PC0=CS_LEFT, PC1=CS_RIGHT (実配線に合わせて変更)
#define CS_LEFT_PORT   GPIOC
#define CS_LEFT_PIN    GPIO_PIN_0
#define CS_RIGHT_PORT  GPIOC
#define CS_RIGHT_PIN   GPIO_PIN_1

/* USER CODE END PV */

/* USER CODE BEGIN PFP */
void Motor_Write(GPIO_TypeDef *cs_port, uint16_t cs_pin,
                 uint8_t phase, uint16_t duty);
void Motor_Drive(int16_t left, int16_t right);
void Motor_Stop(void);
void Line_Control(void);
/* USER CODE END PFP */

// ────────────────────────────────────────────────
// CubeMX生成部分はそのまま（省略せず残す）
// ────────────────────────────────────────────────

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();

  /* USER CODE BEGIN 2 */

  // ADCキャリブレーション（精度向上のため必須）
  HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED);

  // DMA転送開始（1回だけ。完了後自動再起動される循環モード前提）
  HAL_ADC_Start_DMA(&hadc1, (uint32_t *)adc_buf, 4);

  // モータCS初期状態: High（非選択）
  HAL_GPIO_WritePin(CS_LEFT_PORT,  CS_LEFT_PIN,  GPIO_PIN_SET);
  HAL_GPIO_WritePin(CS_RIGHT_PORT, CS_RIGHT_PIN, GPIO_PIN_SET);

  // 起動時モータ停止
  Motor_Stop();
  HAL_Delay(300);

  /* USER CODE END 2 */

  /* Infinite loop */
  while (1)
  {
    /* USER CODE BEGIN 3 */

    // DMA完了待ち（Circularモードなら常時更新されるのでフラグ不要でも可）
    Line_Control();
    HAL_Delay(10);   // 制御周期 10ms

    /* USER CODE END 3 */
  }
}

